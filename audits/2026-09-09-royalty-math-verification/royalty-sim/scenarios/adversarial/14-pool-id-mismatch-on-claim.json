{
  "name": "14-pool-id-mismatch-on-claim",
  "setup": {
    "pools": [{"id": 0, "currency": 0}, {"id": 1, "currency": 0}],
    "stakes": [{"id": 0, "amount": 100}, {"id": 1, "amount": 100}]
  },
  "ops": [
    {"op": "register", "pool": 0, "stake": 0},
    {"op": "register", "pool": 1, "stake": 1},
    {"op": "deposit", "pool": 0, "value": 1000},
    {"op": "deposit", "pool": 1, "value": 500},
    {"op": "pending", "pool": 1, "stake": 0, "expect": {"reward": 0}},
    {"op": "claim", "pool": 1, "stake": 0, "expect": {"abort": 4}},
    {"op": "unregister", "pool": 1, "stake": 0, "expect": {"abort": 4}},
    {"op": "claim", "pool": 0, "stake": 0, "expect": {"reward": 1000}}
  ]
}
