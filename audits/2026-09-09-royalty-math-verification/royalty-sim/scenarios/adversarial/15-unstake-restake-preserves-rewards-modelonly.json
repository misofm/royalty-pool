{
  "name": "15-unstake-restake-preserves-rewards-modelonly",
  "setup": { "pools": [{"id": 0}, {"id": 1}] },
  "ops": [
    {"op": "routed_new", "routed": 0, "parent": 0, "amount": 1000, "routed_pool": 1},
    {"op": "routed_register", "routed": 0, "stake_pool": 0},
    {"op": "new_stake", "stake": 9, "amount": 50},
    {"op": "register", "pool": 1, "stake": 9},

    {"op": "deposit", "pool": 0, "value": 500},
    {"op": "routed_sweep", "routed": 0, "stake_pool": 0},

    {"op": "deposit", "pool": 0, "value": 700},

    {"op": "routed_unregister", "routed": 0, "stake_pool": 0, "expect": {"abort": 5}},

    {"op": "routed_sweep", "routed": 0, "stake_pool": 0},
    {"op": "routed_unregister", "routed": 0, "stake_pool": 0},
    {"op": "routed_unstake", "routed": 0, "expect": {"reward": 1000}},

    {"op": "deposit", "pool": 0, "value": 900, "expect": {"abort": 1}},

    {"op": "routed_sweep", "routed": 0, "stake_pool": 0, "expect": {"abort": 1}},

    {"op": "routed_restake", "routed": 0, "amount": 1000},
    {"op": "routed_register", "routed": 0, "stake_pool": 0},
    {"op": "deposit", "pool": 0, "value": 900},
    {"op": "routed_sweep", "routed": 0, "stake_pool": 0},
    {"op": "pending", "pool": 1, "stake": 9, "expect": {"reward": 2100}}
  ]
}
